# 这是 YAML 格式。复制为 .env 后修改，勿提交真实密码。
app:
  name: "go-gin"
  port: ":8088"
  mode: "debug" # debug、test、release；服务器部署使用 release
  timezone: "Asia/Shanghai"
  timeformat: "2006-01-02 15:04:05"

auth:
  password_private_key: "storage/keys/api_password_private.pem"

db:
  # 先创建 demo 数据库和对应账号，再替换用户名、密码。
  dsn: "app_user:change_me@tcp(127.0.0.1:3306)/demo?charset=utf8mb4&parseTime=true&loc=Asia%2FShanghai"
  max-idle-conn: 10
  max-open-conn: 30
  log-level: "warn" # silent、debug、info、warn、error

redis:
  addr: "127.0.0.1:6379"
  username: ""
  password: "" # Redis 开启认证时填写实际密码
  db: 0

monitor:
  white_ip_list:
    - "127.0.0.1"

log:
  level: "debug" # debug、info、warn、error
  path: "storage/logs/"

# 第三方服务示例地址；使用 rest/ 中的对应客户端前设置为真实地址。
svc:
  user_url: "http://127.0.0.1:8090"
  login_url: "http://127.0.0.1:8091"
